{
  "name": "controle-de-insumos-api",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:http",
    "test:unit": "node --import tsx --test tests/unit/*.test.js",
    "test:http": "npm run build && jest --runInBand",
    "test:coverage": "npm run build && jest --runInBand --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ALVAROVELAME/controle-de-insumos-api.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ALVAROVELAME/controle-de-insumos-api/issues"
  },
  "homepage": "https://github.com/ALVAROVELAME/controle-de-insumos-api#readme",
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "bcryptjs": "^2.4.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.10.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.8.0",
    "nodemailer": "^10.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/plugin-transform-modules-commonjs": "^7.29.14",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^26.1.1",
    "@types/nodemailer": "^6.4.17",
    "jest": "^30.5.2",
    "supertest": "^7.3.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "test-exclude": {
      "minimatch": "^11.0.8",
      "glob": "^14.0.6"
    },
    "@jest/reporters": {
      "glob": "^14.0.6"
    },
    "jest-config": {
      "glob": "^14.0.6"
    },
    "jest-runtime": {
      "glob": "^14.0.6"
    }
  }
}
